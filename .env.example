# ── Garmin MCP ────────────────────────────────────────────────────────────────
# Generate strong secrets with: openssl rand -hex 32
CLIENT_ID=your-garmin-mcp-client-id
CLIENT_SECRET=your-garmin-mcp-client-secret
BASE_URL=https://garmin.yourdomain.com

# ── Strava MCP ────────────────────────────────────────────────────────────────
# MCP OAuth Layer — generate with: openssl rand -hex 32
STRAVA_MCP_CLIENT_ID=your-strava-mcp-client-id
STRAVA_MCP_CLIENT_SECRET=your-strava-mcp-client-secret
STRAVA_BASE_URL=https://strava.yourdomain.com

# Strava API credentials — get from https://www.strava.com/settings/api
STRAVA_API_CLIENT_ID=your-strava-api-client-id
STRAVA_API_CLIENT_SECRET=your-strava-api-client-secret

# Strava OAuth tokens — populated by running: ./strava-auth.sh
STRAVA_ACCESS_TOKEN=
STRAVA_REFRESH_TOKEN=

# ── COROS MCP ─────────────────────────────────────────────────────────────────
# MCP OAuth Layer — generate with: openssl rand -hex 32
COROS_MCP_CLIENT_ID=your-coros-mcp-client-id
COROS_MCP_CLIENT_SECRET=your-coros-mcp-client-secret
COROS_BASE_URL=https://coros.yourdomain.com

# COROS account credentials — used to authenticate with the COROS API directly
COROS_EMAIL=your-coros-email
COROS_PASSWORD=your-coros-password
COROS_REGION=eu
