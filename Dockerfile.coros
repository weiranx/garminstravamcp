# coros-mcp: wrapper (coros-server.js) + coros-mcp installed at build time into a
# venv (pinned via coros-requirements.txt), so container start does no network installs.
FROM node:20-slim AS coros-build
RUN apt-get update && apt-get install -y --no-install-recommends curl ca-certificates git \
    && rm -rf /var/lib/apt/lists/*
RUN curl -LsSf https://astral.sh/uv/0.11.6/install.sh | env UV_INSTALL_DIR=/usr/local/bin sh
ENV UV_PYTHON_INSTALL_DIR=/opt/uv-python UV_NO_CACHE=1
COPY coros-requirements.txt /tmp/
RUN uv venv --python 3.12.13 /opt/coros-mcp \
    && uv pip install --python /opt/coros-mcp/bin/python -r /tmp/coros-requirements.txt \
    && /opt/coros-mcp/bin/coros-mcp --help > /dev/null

FROM node:20-slim
RUN apt-get update && apt-get install -y --no-install-recommends curl ca-certificates tini \
    && rm -rf /var/lib/apt/lists/*
COPY --from=coros-build /opt/uv-python /opt/uv-python
COPY --from=coros-build /opt/coros-mcp /opt/coros-mcp
ENV PATH="/opt/coros-mcp/bin:$PATH"

WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci --omit=dev --no-audit --no-fund && npm cache clean --force
COPY coros-server.js ./

VOLUME ["/root/.config/coros-mcp"]
EXPOSE 8103
# tini as PID 1 forwards SIGTERM so `docker stop/restart` does not wait out the 10s grace period
ENTRYPOINT ["/usr/bin/tini", "--"]
CMD ["node", "coros-server.js"]
